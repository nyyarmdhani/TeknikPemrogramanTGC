# Fungsi 1: QC Data Seismik
def qc_seismik(data, ambang_offset):
    laporan = {}
    for survey_name, survey_data in data.items():
        ok_count = 0
        bad_count = 0

        for trace in survey_data["seismik"]:
            # Asumsi QC_flag sudah ada dari data_survei
            if trace["offset"] > ambang_offset:
                trace["QC_flag"] = "BAD"
                bad_count += 1
            else:
                # Hanya menambahkan jika sudah OK atau menjadi OK
                ok_count += 1

        laporan[survey_name] = {"OK": ok_count, "BAD": bad_count}

    return laporan

# Fungsi 2: Statistik Gravitasi
def statistik_gravitasi(data):
    rata_per_survey = {}
    semua_nilai = []

    for survey_name, survey_data in data.items():
        nilai_gravitasi = [point["nilai"] for point in survey_data["gravitasi"]]
        rata_per_survey[survey_name] = sum(nilai_gravitasi) / len(nilai_gravitasi)
        semua_nilai.extend(nilai_gravitasi)

    return {
        "rata_per_survey": rata_per_survey,
        "terendah": min(semua_nilai),
        "tertinggi": max(semua_nilai)
    }

# Fungsi 3: Analisis Magnetik
def analisis_magnetik(data):
    semua_nilai = []

    for survey_data in data.values():
        for point in survey_data["magnetik"]:
            semua_nilai.append(point["nilai"])

    nilai_unik = sorted(set(semua_nilai))

    return {
        "semua_nilai": semua_nilai,
        "nilai_unik": nilai_unik,
        "jumlah_unik": len(nilai_unik)
    }

